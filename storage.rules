rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Products folder: authenticated users can upload their own product images
    match /products/{userId}/{imageId} {
      // Allow read: public can read product images
      allow read: if true;
      
      // Allow write: authenticated users can only upload to their own folder
      allow write: if request.auth != null && request.auth.uid == userId &&
                     request.resource.size < 10 * 1024 * 1024 && // 10MB max
                     request.resource.contentType.matches('image/.*');
      
      // Allow delete: only the owner can delete
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

